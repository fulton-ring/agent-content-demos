diff --git a/src/overpass_parser/mod.rs b/src/overpass_parser/mod.rs
index 599975c..e15801a 100644
--- a/src/overpass_parser/mod.rs
+++ b/src/overpass_parser/mod.rs
@@ -19,10 +19,44 @@ use request::Request;
 #[grammar = "overpass.pest"]
 pub struct OverpassParser;
 
+/// Overpass QL features this compiler doesn't support, by a pattern that finds them in the query.
+const UNSUPPORTED: [(&str, &str); 17] = [
+    (r"\[\s*date\s*:", "attic queries ([date:])"),
+    (r"\[\s*adiff\s*:", "augmented diffs ([adiff:])"),
+    (r"\[\s*diff\s*:", "diffs ([diff:])"),
+    (r"\[\s*out\s*:\s*(xml|csv|custom|popup)", "output formats other than [out:json]"),
+    (r"\bif\s*[(:]", "if"),
+    (r"\bcomplete\b", "complete"),
+    (r"\bretro\b", "retro"),
+    (r"\bcompare\b", "compare"),
+    (r"\bmake\b", "make (evaluators)"),
+    (r"\bis_in\b", "is_in"),
+    (r"\bmap_to_area\b", "map_to_area"),
+    (r"\btimeline\b", "timeline"),
+    (r"\blocal\b", "local"),
+    (r"\bpivot\b", "pivot"),
+    (r"\(\s*changed\b", "changed"),
+    (r"\(\s*(user|uid|newer)\s*:", "user, uid and newer filters"),
+    (r"\bout\b[^;]*\b(tags|count)\b[^;]*\b(geom|bb|center)\b", "out with both count/tags and geometry"),
+];
+
 pub fn parse_query(query: &str) -> Result<Request, pest::error::Error<Rule>> {
     match OverpassParser::parse(Rule::request, query) {
         Ok(mut pairs) => Request::from_pest(pairs.next().unwrap()),
-        Err(e) => Err(e),
+        Err(e) => {
+            let feature = UNSUPPORTED
+                .iter()
+                .find(|(pattern, _)| regex::Regex::new(pattern).unwrap().is_match(query));
+            match feature {
+                Some((_, name)) => Err(pest::error::Error::new_from_pos(
+                    pest::error::ErrorVariant::CustomError {
+                        message: format!("unsupported Overpass QL feature: {name}"),
+                    },
+                    pest::Position::from_start(query),
+                )),
+                None => Err(e),
+            }
+        }
     }
 }
 
