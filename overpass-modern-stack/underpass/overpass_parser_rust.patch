+        fn members_join(&self, alias: &str, as_name: &str) -> (String, String) {
+            (
+                format!("CROSS JOIN LATERAL jsonb_to_recordset({alias}.members) AS {as_name}(type text, ref bigint, role text)"),
+                format!("{as_name}."),
+            )
+        }
+
+        fn list_overlaps_ids(&self, list: &str, table: &str, cond: &str) -> String {
+            format!("{list} && ARRAY(SELECT id FROM {table} WHERE {cond})")
+        }
+
+        fn json_strip_nulls_of(&self, object: &str) -> String {
+            format!("jsonb_strip_nulls({object})")
+        }
+
+        fn empty_tags_to_null(&self, tags: &str) -> String {
+            format!("NULLIF({tags}, '{{}}'::jsonb)")
+        }
+
+        fn way_geometry_points(&self, geom: &str) -> String {
+            format!(
+                "(SELECT jsonb_agg(jsonb_build_object('lat', ROUND(ST_Y(dp.geom)::numeric, 7), 'lon', ROUND(ST_X(dp.geom)::numeric, 7)) ORDER BY dp.path) FROM ST_DumpPoints({geom}) AS dp)"
+            )
+        }
+
+        fn round7(&self, expr: &str) -> String {
+            format!("ROUND(({expr})::numeric, 7)")
+        }
+
         fn statement_timeout(&self, timeout: u32) -> Option<String> {
             Some(format!("SET statement_timeout = {timeout};"))
         }
