{
  "organization": "Northside Youth Partnership",
  "program": "Community Schools After-School Program",
  "fiscal_year_start_month": 7,
  "submission_due_days_after_quarter": 15,
  "max_program_hours_per_weekday": 4,
  "sites": [
    {
      "id": "eastgate",
      "name": "Eastgate Elementary",
      "grades": ["K", "1", "2", "3", "4", "5"],
      "submits": "Spreadsheet the site coordinator keeps by hand",
      "adapter": "roster",
      "file": "xlsx",
      "sheet": "Roster",
      "header_contains": "Student ID",
      "columns": {
        "pid": "Student ID",
        "grade": "Grade",
        "enroll_date": "Enroll Date",
        "exit_date": "Exit Date",
        "days_enrolled": "Days Enrolled",
        "days_attended": "Days Present",
        "program_hours": "ASP Hours",
        "on_track": "Reading Benchmark",
        "family_engaged": "Family Night"
      },
      "true_values": ["Met", "Y"],
      "false_values": ["Not Met", "N", ""],
      "blank_means_not_assessed": ["on_track"],
      "reported_total_label": "Total students"
    },
    {
      "id": "riverside",
      "name": "Riverside Middle",
      "grades": ["6", "7", "8"],
      "submits": "Case-management export (one row per service) plus the district attendance file",
      "adapter": "cms_export",
      "services_file": "cms_services",
      "school_file": "district_attendance",
      "columns": {
        "record_id": "Service Record ID",
        "pid": "Participant ID",
        "grade": "Grade Level",
        "service_type": "Service Type",
        "minutes": "Duration (Minutes)",
        "school_pid": "LOCAL_ID",
        "days_enrolled": "DAYS_ENROLLED",
        "days_absent": "DAYS_ABSENT",
        "on_track": "ELA_BENCHMARK"
      },
      "family_service_types": ["Family Event"],
      "true_values": ["ON TRACK"],
      "false_values": ["BELOW"],
      "not_assessed_values": ["NOT TESTED", ""]
    },
    {
      "id": "lincoln",
      "name": "Lincoln Heights K-8",
      "grades": ["K", "1", "2", "3", "4", "5", "6", "7", "8"],
      "submits": "One-page summary form (site totals only)",
      "adapter": "summary",
      "file": "csv",
      "measures": {
        "enrolled": "Students enrolled",
        "ada_pct": "Average daily attendance (%)",
        "chronic_eligible": "Students enrolled 10+ days",
        "chronic": "Students chronically absent",
        "program_hours": "Total program hours",
        "hours_45_plus": "Students with 45+ program hours",
        "assessed": "Students assessed in reading",
        "on_track": "Students on track in reading",
        "family_engaged": "Families attending 1+ event"
      }
    },
    {
      "id": "westfield",
      "name": "Westfield High",
      "grades": ["9", "10", "11", "12"],
      "submits": "Spreadsheet with a title block, absences instead of days present",
      "adapter": "roster",
      "file": "xlsx",
      "sheet": 0,
      "header_contains": "ID #",
      "columns": {
        "pid": "ID #",
        "grade": "Gr",
        "enroll_date": "Start",
        "exit_date": "End",
        "days_enrolled": "Enrolled Days",
        "days_absent": "Absences",
        "program_hours": "Hours in Program",
        "on_track": "On Track (Credits)?",
        "family_engaged": "Family Contact"
      },
      "true_values": ["Yes", "Y", "1", "1.0"],
      "false_values": ["No", "N", "0", "0.0", ""],
      "blank_means_not_assessed": ["on_track"]
    },
    {
      "id": "harbor",
      "name": "Harbor View Elementary",
      "grades": ["K", "1", "2", "3", "4", "5"],
      "submits": "The organization's CSV template",
      "adapter": "roster",
      "file": "csv",
      "header_contains": "participant_id",
      "columns": {
        "pid": "participant_id",
        "grade": "grade",
        "enroll_date": "enroll_date",
        "exit_date": "exit_date",
        "days_enrolled": "school_days_enrolled",
        "days_attended": "school_days_attended",
        "program_hours": "program_hours",
        "on_track": "reading_on_track",
        "family_engaged": "family_engaged"
      },
      "true_values": ["yes"],
      "false_values": ["no", ""],
      "blank_means_not_assessed": ["on_track"]
    }
  ]
}
